# Copie para .env antes de subir a stack:  cp .env.example .env
# O .env NÃO deve ser versionado — ele carrega as senhas locais.

# --- UID do host (evita arquivos root nos volumes montados) ---
# Linux/macOS: rode `id -u` e use o valor. Windows/Docker Desktop: deixe 50000.
AIRFLOW_UID=50000

# --- PostgreSQL (metadados do Airflow + schema Ouro) ---
POSTGRES_USER=classolos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow
GOLD_DB=classolosbr_ns

# --- MinIO (S3 local: camadas Bronze e Prata) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
S3_ENDPOINT=http://minio:9000
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold

# --- Airflow (usuário inicial da UI) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Fonte BDSolos ---
# Caminho DENTRO do contêiner. O docker-compose monta ../../raw como somente-leitura.
BDSOLOS_CSV=/opt/airflow/raw/bd_solos_para_redape.csv

# Valores esperados, verificados contra o arquivo em 2026-08-31.
# Se a validação do DAG falhar aqui, a fonte mudou — investigue antes de ajustar.
BDSOLOS_HORIZONTES_ESPERADOS=34108
BDSOLOS_PERFIS_ESPERADOS=8925
BDSOLOS_COLUNAS_ESPERADAS=275
